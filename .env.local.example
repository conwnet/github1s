# Copy to .env.local and adjust values.
# Loaded automatically by npm run watch / npm run build.

PLATFORM=gitlab
GITLAB_DOMAIN=https://git.selectel.org

# Dev: relative path proxied by webpack-dev-server (avoids CORS).
GITLAB_API_PREFIX=/api/gitlab

# Prod build: use full API URL instead of /api/gitlab
# GITLAB_API_PREFIX=https://git.selectel.org/api/v4

# Test project (for manual checks; webpack injects it into the extension):
# GITLAB_TEST_PROJECT=mamashev.z/test_proj
